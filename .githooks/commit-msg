#!/bin/sh
subject=$(head -n 1 "$1")
if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9.-]+\))?(!)?: .+'; then
  echo 'Usa Conventional Commits, por ejemplo: feat(installer): add desktop shortcut' >&2
  exit 1
fi
if [ "${#subject}" -gt 72 ]; then
  echo 'El asunto del commit debe tener como maximo 72 caracteres.' >&2
  exit 1
fi
