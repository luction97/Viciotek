<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.CoverGalleryDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          xmlns:presentation="clr-namespace:Viciotek.Presentation"
                          xmlns:controls="clr-namespace:Viciotek.Presentation.Controls"
                          Title="Buscar portada"
                          Width="760"
                          Height="620">
    <Border Margin="20"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="12" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Buscar portada"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="Cerrar"
                        Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="26,4,26,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="SearchBox" Style="{StaticResource FormTextBoxStyle}"
                             AutomationProperties.Name="Nombre del juego"
                             KeyDown="SearchBox_KeyDown"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="SearchPlaceholder" Text="Ingresá el nombre del juego"
                               Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource TextTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1"
                        Content="Buscar"
                        Style="{StaticResource GhostButtonStyle}"
                        Height="38"
                        Margin="8,0,0,0"
                        Command="{Binding SearchCommand}" />
            </Grid>

            <ListBox Grid.Row="2" Margin="26,0,26,8" MaxHeight="88"
                     ItemsSource="{Binding Matches}" DisplayMemberPath="Name"
                     Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgBrush}"
                     BorderThickness="0" SelectionChanged="Game_SelectionChanged">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Matches.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="26,0,26,8" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <Border Grid.Row="4" Margin="26,0,26,8" Background="{StaticResource BgBrush}" CornerRadius="10">
                <Grid>
                    <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}"
                             Style="{StaticResource GalleryListBoxStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ItemWidth="120" ItemHeight="180" Gap="12"
                                                                   HorizontalPadding="10" VerticalPadding="10" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SelectionBorder" BorderThickness="2" BorderBrush="Transparent" CornerRadius="7">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type presentation:CoverCandidate}">
                                    <Border CornerRadius="8" Cursor="Hand">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Border Background="#66000000"
                                                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="…"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Buscando…"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Border Grid.Row="5"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Cancelar"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="36"
                                Padding="18,0"
                                IsCancel="True"
                                Click="Cancel_Click" />
                        <Button Content="Usar esta portada"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
