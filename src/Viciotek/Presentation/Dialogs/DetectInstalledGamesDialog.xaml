<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.DetectInstalledGamesDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs" xmlns:loc="clr-namespace:Viciotek.Localization"
 Width="640" Height="520" Title="{loc:Text ReviewImport}" FontFamily="{StaticResource AppFont}" Foreground="{DynamicResource TextPrimaryBrush}">
 <Border Style="{StaticResource DialogSurfaceStyle}"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown"><TextBlock Text="{loc:Text ReviewImport}" FontSize="21" FontWeight="SemiBold" Margin="26,0" VerticalAlignment="Center"/>
   <Button Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Margin="0,0,18,0" ToolTip="{loc:Text Close}" Click="Cancel_Click"/>
  </Grid>
  <TextBlock x:Name="Instruction" Grid.Row="1" Text="{loc:Text ReviewImportHint}" Margin="26,0,26,16" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
  <ListBox Grid.Row="2" x:Name="Results" Margin="26,0" ItemsSource="{Binding Choices}" Style="{StaticResource GalleryListBoxStyle}" AutomationProperties.Name="{loc:Text ReviewImport}">
   <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8,0" MinHeight="36" VerticalContentAlignment="Center" Margin="0,3" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Click="Choice_Click"/></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,0" VerticalAlignment="Center">
   <Button Content="{loc:Text Cancel}" Style="{StaticResource GhostButtonStyle}" MinHeight="40" Padding="16,0" IsCancel="True" Click="Cancel_Click"/>
   <Button x:Name="ImportButton" Content="{loc:Text ImportSelected}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="40" Margin="12,0,0,0" IsDefault="True" Click="Import_Click"/>
  </StackPanel>
 </Grid></Border>
</local:ViciotekDialogWindow>
