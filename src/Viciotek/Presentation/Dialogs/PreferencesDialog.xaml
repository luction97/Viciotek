<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.PreferencesDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Viciotek.Localization"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="{loc:Text Settings}"
                          FontFamily="{StaticResource AppFont}" FontSize="14"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          Width="660"
                          SizeToContent="Height" MinHeight="480">
    <Border Style="{StaticResource DialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="HeadingText" Text="{loc:Text Settings}"
                           Margin="32,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="22"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="{loc:Text Close}"
                        Click="CancelButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,6,32,8">
                    <Border Style="{StaticResource DialogSectionStyle}"><StackPanel>
                    <Grid x:Name="ProviderHeader" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource ProviderIconBackgroundBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{DynamicResource ActionAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SteamGridDB" FontSize="15" FontWeight="Medium" />
                            <TextBlock Text="{loc:Text AutomaticCoversForYourGamesOptional}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="1" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" FontSize="15" Content="{loc:Text GetMyCode}" Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Left" Padding="0" Click="OpenSteamGridDb_Click" />
                    </Grid>
                    <TextBlock Text="{loc:Text SignInAndCopyYourApiKeyCode}"
                               Style="{StaticResource FieldHintStyle}" FontSize="15" LineHeight="22" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,4,0,18" />
                    <StackPanel Orientation="Horizontal"><TextBlock Text="2" Width="24" Margin="0,0,0,10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" /><Label Content="{loc:Text PasteYourCodeToConnect}" Target="{Binding ElementName=ApiKeyBox}"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Padding="0,0,0,10" /></StackPanel>
                    <Grid Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox FontSize="15" x:Name="ApiKeyBox"
                                     AutomationProperties.Name="{loc:Text SteamgriddbConnectionCode}"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                     Style="{StaticResource FormPasswordBoxStyle}" />
                        <Button FontSize="14" x:Name="PasteButton" Grid.Column="1" Content="&#xE77F;" FontFamily="{StaticResource IconFont}"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{loc:Text PasteCode}"
                                Click="PasteCode_Click" />
                        <Button FontSize="14" x:Name="VerifyButton" Grid.Column="2" Content="{loc:Text Connect}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"
                                IsEnabled="False" Click="VerifyConnection_Click" />
                    </Grid>
                    <TextBlock x:Name="ConnectionStatusText" TextWrapping="Wrap" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="24,10,0,0"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel></Border>
                                        <Button x:Name="LanguageButton" AutomationProperties.Name="{loc:Text Language}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left"
                            Padding="0" Margin="0,12,0,0" Click="LanguageButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Text Language}" />
                            <TextBlock Text=" · " />
                            <TextBlock x:Name="SelectedLanguageText" />
                            <TextBlock Text="⌄" Margin="10,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="SystemLanguageItem" IsCheckable="True" Header="{loc:Text SystemDefault}" Tag="auto" Click="LanguageChoice_Click">
                                    <MenuItem.Icon><TextBlock x:Name="SystemLanguageCheck" Text="✓" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="SpanishLanguageItem" IsCheckable="True" Header="Español" Tag="es" Click="LanguageChoice_Click">
                                    <MenuItem.Icon><TextBlock x:Name="SpanishLanguageCheck" Text="✓" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="EnglishLanguageItem" IsCheckable="True" Header="English" Tag="en" Click="LanguageChoice_Click">
                                    <MenuItem.Icon><TextBlock x:Name="EnglishLanguageCheck" Text="✓" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Expander x:Name="LibraryOptions" IsExpanded="False" Margin="0,20,0,4"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="14" FocusVisualStyle="{StaticResource FocusRingStyle}">
                        <Expander.Template>
                            <ControlTemplate TargetType="{x:Type Expander}">
                                <StackPanel>
                                    <ToggleButton x:Name="OptionsToggle" Background="Transparent"
                                                  AutomationProperties.Name="{loc:Text ShowOrHideMoreOptions}"
                                                  Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0"
                                                  HorizontalAlignment="Left" Padding="0,8" Cursor="Hand"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  FocusVisualStyle="{StaticResource FocusRingStyle}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="OptionsLabel" Opacity="0.82" Text="{loc:Text MoreOptions}" />
                                                        <TextBlock x:Name="Chevron" Text="⌄" Margin="10,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="OptionsLabel" Property="Opacity" Value="1" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="OptionsLabel" Property="Text" Value="{loc:Text FewerOptions}" />
                                                        <Setter TargetName="Chevron" Property="Text" Value="⌃" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="OptionsContent" Visibility="Collapsed" Margin="0,8,0,12" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="OptionsContent" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Expander.Template>
                        <Border Style="{StaticResource DialogSectionStyle}"><StackPanel>
                            <TextBlock Text="{loc:Text Library}" FontSize="15" FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0" />
                            <CheckBox x:Name="AutoFetchCheckBox"
                                      Content="{loc:Text FindCoversAutomaticallyWhenAddingGames}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" />

                            <CheckBox x:Name="AnimationsCheckBox"
                                      Content="{loc:Text HoverEffectOnCovers}"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" />

                            <Grid Margin="0,18,0,8">
                                <TextBlock Text="{loc:Text CoverSize}" />
                                <TextBlock x:Name="CoverSizeLabel" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="CoverSizeSlider" Minimum="0" Maximum="3" TickFrequency="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                    SmallChange="1" LargeChange="1" Value="2"
                                    AutomationProperties.Name="{loc:Text CoverSize}"
                                    Style="{StaticResource CoverSizeSliderStyle}" ValueChanged="CoverSizeSlider_ValueChanged" />
                            <Label Content="{loc:Text LocalData}" Target="{Binding ElementName=DataPathBox}"
                                   FontSize="15" FontWeight="Medium" Padding="0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DataPathBox" AutomationProperties.Name="{loc:Text LocalDataFolder}"
                                         Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Padding="0" />
                                <Button FontSize="14" Grid.Column="1" Content="{loc:Text OpenFolder}"
                                        Style="{StaticResource GhostButtonStyle}" Height="38"
                                        Margin="8,0,0,0" Click="OpenDataFolder_Click" />
                            </Grid>
                        </StackPanel></Border>
                    </Expander>
                    <TextBlock x:Name="StatusText" Style="{StaticResource DialogErrorStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2">
                <Grid Margin="32,0">
                    <Button FontSize="14" x:Name="AboutButton" Content="{loc:Text AboutViciotek}"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="About_Click" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button FontSize="14" x:Name="SaveButton" Content="{loc:Text Done}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
