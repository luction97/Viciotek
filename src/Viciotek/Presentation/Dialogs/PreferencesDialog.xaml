<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.PreferencesDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="Configuración"
                          FontFamily="{StaticResource AppFont}" FontSize="13"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Width="590"
                          SizeToContent="Height" MinHeight="490" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Border Style="{StaticResource DialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Configuración"
                           Margin="32,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="19"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="Cerrar"
                        Click="CancelButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,6,32,8">
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="12" Background="#242932" HorizontalAlignment="Left">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{StaticResource ActionAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SteamGridDB" FontSize="14" FontWeight="Medium" />
                            <TextBlock Text="Portadas automáticas para tus juegos. Opcional."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="1" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" FontSize="13" Content="Obtener mi código ↗" Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Left" Padding="0" Click="OpenSteamGridDb_Click" />
                    </Grid>
                    <TextBlock Text="Iniciá sesión y copiá tu código «API Key»."
                               Style="{StaticResource FieldHintStyle}" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="24,4,0,22" />
                    <StackPanel Orientation="Horizontal"><TextBlock Text="2" Width="24" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" /><Label Content="Pegá el _código para conectar" Target="{Binding ElementName=ApiKeyBox}"
                           Foreground="{StaticResource TextSecondaryBrush}" Padding="0,0,0,10" /></StackPanel>
                    <Grid Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox"
                                     AutomationProperties.Name="Código de conexión de SteamGridDB"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                     Style="{StaticResource FormPasswordBoxStyle}" />
                        <Button x:Name="PasteButton" Grid.Column="1" Content="&#xE77F;" FontFamily="{StaticResource IconFont}"
                                Style="{StaticResource IconButtonStyle}"
                                Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Pegar código"
                                Click="PasteCode_Click" />
                        <Button x:Name="VerifyButton" Grid.Column="2" Content="Conectar"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0"
                                IsEnabled="False" Click="VerifyConnection_Click" />
                    </Grid>
                    <TextBlock x:Name="ConnectionStatusText" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                               Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    <Expander x:Name="LibraryOptions" IsExpanded="False" Margin="0,20,0,4"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontSize="13" FocusVisualStyle="{StaticResource FocusRingStyle}">
                        <Expander.Template>
                            <ControlTemplate TargetType="{x:Type Expander}">
                                <StackPanel>
                                    <ToggleButton x:Name="OptionsToggle" Background="Transparent"
                                                  AutomationProperties.Name="Mostrar u ocultar más opciones"
                                                  Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0"
                                                  HorizontalAlignment="Left" Padding="0,8" Cursor="Hand"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  FocusVisualStyle="{StaticResource FocusRingStyle}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="OptionsLabel" Text="Más opciones" />
                                                        <TextBlock x:Name="Chevron" Text="⌄" Margin="10,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="OptionsLabel" Property="Text" Value="Menos opciones" />
                                                        <Setter TargetName="Chevron" Property="Text" Value="⌃" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="OptionsContent" Visibility="Collapsed" Margin="0,8,0,12" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="OptionsContent" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Expander.Template>
                        <StackPanel>
                            <TextBlock Text="Biblioteca" FontSize="14" FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,0" />
                            <CheckBox x:Name="AutoFetchCheckBox"
                                      Content="Buscar portadas automáticamente al agregar juegos"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" />

                            <CheckBox x:Name="AnimationsCheckBox"
                                      Content="Efecto al pasar el cursor sobre las portadas"
                                      Style="{StaticResource CheckBoxStyle}" Margin="0,10,0,0" />

                            <Label Content="_Datos locales" Target="{Binding ElementName=DataPathBox}"
                                   FontSize="14" FontWeight="Medium" Padding="0"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,18,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DataPathBox" AutomationProperties.Name="Carpeta de datos locales"
                                         Style="{StaticResource FormTextBoxStyle}" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Padding="0" />
                                <Button Grid.Column="1" Content="Abrir carpeta"
                                        Style="{StaticResource GhostButtonStyle}" Height="38"
                                        Margin="8,0,0,0" Click="OpenDataFolder_Click" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="StatusText" Style="{StaticResource DialogErrorStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2">
                <Grid Margin="32,0">
                    <Button x:Name="AboutButton" Content="Acerca de VICIOTEK"
                            Style="{StaticResource GhostButtonStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="About_Click" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="SaveButton" Content="Listo"
                                Style="{StaticResource WelcomeButtonStyle}"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
