<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.PreferencesDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="Preferencias"
                          Width="660"
                          Height="560">
    <Border Margin="20"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="12" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Preferencias"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="Cerrar"
                        Click="CancelButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,4,26,26">
                    <TextBlock Text="PORTADAS AUTOMÁTICAS"
                               Style="{StaticResource FieldLabelStyle}"
                               FontSize="11" />

                    <TextBlock Text="CLAVE DE STEAMGRIDDB (OPCIONAL)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,7" />
                    <PasswordBox x:Name="ApiKeyBox"
                                 AutomationProperties.Name="Clave de SteamGridDB"
                                 Style="{StaticResource FormPasswordBoxStyle}" />
                    <Button Content="Obtener clave ↗"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Left"
                            Padding="0"
                            Margin="0,7,0,0"
                            Click="OpenSteamGridDb_Click" />
                    <Button x:Name="VerifyButton"
                            Content="Verificar conexión"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="30"
                            Padding="12,0"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            IsEnabled="False"
                            Click="VerifyConnection_Click" />
                    <TextBlock Text="Protegida para este usuario de Windows."
                               Style="{StaticResource FieldHintStyle}"
                               Margin="0,7,0,0" />

                    <CheckBox x:Name="AutoFetchCheckBox"
                              Content="Buscar portadas automáticamente al agregar juegos"
                              Style="{StaticResource CheckBoxStyle}"
                              Margin="0,22,0,0" />

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,24,0,22" />

                    <TextBlock Text="INTERFAZ"
                               Style="{StaticResource FieldLabelStyle}"
                               FontSize="11" />
                    <CheckBox x:Name="AnimationsCheckBox"
                              Content="Efecto al pasar el cursor sobre las portadas"
                              Style="{StaticResource CheckBoxStyle}"
                              Margin="0,14,0,0" />

                    <TextBlock Text="DATOS LOCALES"
                               Style="{StaticResource FieldLabelStyle}"
                               FontSize="11"
                               Margin="0,24,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DataPathBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 IsReadOnly="True" />
                        <Button Grid.Column="1"
                                Content="Abrir carpeta"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="38"
                                Margin="8,0,0,0"
                                Click="OpenDataFolder_Click" />
                    </Grid>

                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource DialogErrorStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,16,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="26,0">
                    <Button Content="Acerca de VICIOTEK"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="About_Click" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Cancelar"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="36"
                                Padding="18,0"
                                IsCancel="True" />
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
