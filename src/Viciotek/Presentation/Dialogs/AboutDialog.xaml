<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.AboutDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="Acerca de"
                          Width="420"
                          Height="500">
    <Border Margin="20"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="12" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Acerca de"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="Cerrar"
                        Click="Close_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="30,8,30,20" VerticalAlignment="Center">
                <Image Width="76"
                       Height="76"
                       Margin="0,0,0,16"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Source>
                        <BitmapImage UriSource="pack://application:,,,/Assets/icono/viciotek.png" DecodePixelWidth="192" />
                    </Image.Source>
                </Image>
                <TextBlock Text="VICIOTEK"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Biblioteca personal de videojuegos."
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <Border Height="1"
                        Background="{StaticResource BorderBrush}"
                        Margin="0,22,0,20" />
                <TextBlock Text="Creado por Lucas Siano"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="© 2026 Lucas Siano. Todos los derechos reservados."
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11.5"
                           Foreground="{StaticResource TextTertiaryBrush}" />
                <TextBlock x:Name="VersionText"
                           Margin="0,14,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11.5"
                           Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="26,0">
                    <Button Content="Cerrar"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="36"
                            Padding="18,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsCancel="True"
                            IsDefault="True"
                            Click="Close_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
