<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.GameEditDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="Editar juego"
                          Width="640"
                          SizeToContent="Height" MinHeight="290" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <Border Style="{StaticResource DialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Editar juego"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="Cerrar"
                        Click="CancelButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,4,26,26">
                    <TextBlock Text="NOMBRE"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource FormTextBoxStyle}"
                             MaxLength="200"
                             TextChanged="Field_TextChanged" />

                    <Expander Style="{StaticResource DisclosureStyle}" x:Name="AdvancedOptions" Header="Opciones avanzadas" IsExpanded="False" Margin="0,20,0,0" Foreground="{StaticResource TextSecondaryBrush}"><StackPanel>
                    <TextBlock Text="ARCHIVO O ENLACE DEL JUEGO"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,18,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 TextChanged="Field_TextChanged" />
                        <Button Grid.Column="1"
                                Content="Examinar…"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="38"
                                Margin="8,0,0,0"
                                Click="BrowseTarget_Click" />
                    </Grid>
                    <TextBlock x:Name="TargetHint"
                               Style="{StaticResource FieldHintStyle}" />

                    <TextBlock Text="OPCIONES DE INICIO (OPCIONAL)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,18,0,7" />
                    <TextBox x:Name="ArgumentsBox"
                             Style="{StaticResource FormTextBoxStyle}"
                             TextChanged="Field_TextChanged" />

                    <TextBlock Text="CARPETA DEL JUEGO (OPCIONAL)"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,18,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkingDirectoryBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 TextChanged="Field_TextChanged" />
                        <Button x:Name="BrowseFolderButton"
                                Grid.Column="1"
                                Content="Elegir…"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="38"
                                Margin="8,0,0,0"
                                Click="BrowseFolder_Click" />
                    </Grid>

                    </StackPanel></Expander>
                    <TextBlock x:Name="ErrorText"
                               Style="{StaticResource DialogErrorStyle}"
                               Margin="0,16,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Cancelar"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="36"
                                Padding="18,0"
                                IsCancel="True" />
                        <Button x:Name="SaveButton" Content="Guardar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
