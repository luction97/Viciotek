<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.GameEditDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Viciotek.Localization"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="{loc:Text EditGame}"
                          Width="640" FontFamily="{StaticResource AppFont}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                          SizeToContent="Height" MinHeight="280">
    <Border Style="{StaticResource DialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{loc:Text EditGame}"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="{loc:Text Close}"
                        Click="CancelButton_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,4,26,8">
                    <Border Style="{StaticResource DialogSectionStyle}"><StackPanel>
                    <TextBlock Text="{loc:Text Name}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="NameBox"
                             Style="{StaticResource FormTextBoxStyle}"
                             MaxLength="200"
                             TextChanged="Field_TextChanged" />

                    </StackPanel></Border>
                    <Expander Style="{StaticResource DisclosureStyle}" x:Name="AdvancedOptions" Header="{loc:Text AdvancedOptions}" IsExpanded="False" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"><Border Style="{StaticResource DialogSectionStyle}"><StackPanel>
                    <TextBlock Text="{loc:Text GameFileOrLink}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,0,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 TextChanged="Field_TextChanged" />
                        <Button Grid.Column="1"
                                Content="{loc:Text Browse}"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="38"
                                Margin="8,0,0,0"
                                Click="BrowseTarget_Click" />
                    </Grid>
                    <TextBlock x:Name="TargetHint"
                               Style="{StaticResource FieldHintStyle}" />

                    <TextBlock Text="{loc:Text LaunchOptionsOptional}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,18,0,7" />
                    <TextBox x:Name="ArgumentsBox"
                             Style="{StaticResource FormTextBoxStyle}"
                             TextChanged="Field_TextChanged" />

                    <TextBlock Text="{loc:Text GameFolderOptional}"
                               Style="{StaticResource FieldLabelStyle}"
                               Margin="0,18,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkingDirectoryBox"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 TextChanged="Field_TextChanged" />
                        <Button x:Name="BrowseFolderButton"
                                Grid.Column="1"
                                Content="{loc:Text Choose}"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="38"
                                Margin="8,0,0,0"
                                Click="BrowseFolder_Click" />
                    </Grid>

                    </StackPanel></Border></Expander>
                    <TextBlock x:Name="ErrorText"
                               Style="{StaticResource DialogErrorStyle}"
                               Margin="0,16,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{loc:Text Cancel}"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="36"
                                Padding="18,0"
                                IsCancel="True" />
                        <Button x:Name="SaveButton" Content="{loc:Text Save}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
