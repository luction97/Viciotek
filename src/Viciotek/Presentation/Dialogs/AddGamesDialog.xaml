<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.AddGamesDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Viciotek.Localization"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="{loc:Text AddGames}"
                          Width="480"
                          Height="380"
                          AllowDrop="True"
                          DragOver="OnDragOver"
                          Drop="OnDrop">
    <Border Style="{StaticResource DialogSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="{loc:Text AddGames}"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="{loc:Text Close}"
                        Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="26,4,26,20" VerticalAlignment="Center">
                <TextBlock Text="&#xE710;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Text="{loc:Text DropYourGamesHere}"
                           Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="15"
                           LineHeight="21"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Text GameShortcutsOrFiles}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Row="2">
                <Grid Margin="26,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{loc:Text Cancel}"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="36"
                                Padding="18,0"
                                IsCancel="True"
                                Click="Cancel_Click" />
                        <Button Content="{loc:Text ChooseGame}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                IsDefault="True"
                                Click="ChooseFiles_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
