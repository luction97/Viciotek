<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.CoverSourceDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Viciotek.Localization"
 xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
 Title="{loc:Text ChangeCover2}" Width="520" SizeToContent="Height" MinHeight="300"
 FontFamily="{StaticResource AppFont}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}">
 <Border Style="{StaticResource DialogSurfaceStyle}">
  <Grid Margin="30,20">
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="56"/></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <TextBlock Text="{loc:Text ChangeCover2}" FontSize="21" FontWeight="Medium" VerticalAlignment="Center"/>
    <Button Content="&#xE8BB;" Style="{StaticResource IconButtonStyle}" FontFamily="{StaticResource IconFont}"
     HorizontalAlignment="Right" ToolTip="{loc:Text Close}" Click="CloseButton_Click"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,16,0,8">
    <Button x:Name="WebButton" Content="{loc:Text SearchSteamgriddb}" Style="{StaticResource PrimaryButtonStyle}"
     FontSize="14" HorizontalAlignment="Left" Padding="0" Click="Web_Click"/>
    <Button x:Name="LocalButton" Content="{loc:Text ChooseAnImageFromThisComputer}" Style="{StaticResource GhostButtonStyle}" FontSize="14"
     HorizontalAlignment="Left" Padding="0" Margin="0,12,0,0" Click="Local_Click"/>
    <Expander Style="{StaticResource DisclosureStyle}" x:Name="AutomaticOptions" Header="{loc:Text MoreOptions}" IsExpanded="False" Margin="0,18,0,0"
     Foreground="{DynamicResource TextSecondaryBrush}">
     <Button Content="{loc:Text ChooseACoverAutomatically}" Style="{StaticResource GhostButtonStyle}" Padding="0"
      HorizontalAlignment="Left" Margin="0,8,0,0" Click="Automatic_Click"/>
    </Expander>
   </StackPanel>
   <Button Grid.Row="2" Content="{loc:Text Cancel}" Style="{StaticResource GhostButtonStyle}" IsCancel="True"
    HorizontalAlignment="Right" VerticalAlignment="Center" Click="CloseButton_Click"/>
  </Grid>
 </Border>
</local:ViciotekDialogWindow>
