<local:ViciotekDialogWindow x:Class="Viciotek.Presentation.Dialogs.ConfirmDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:local="clr-namespace:Viciotek.Presentation.Dialogs"
                          Title="Confirmar"
                          Width="560"
                          Height="340">
    <Border Margin="20"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="12" Opacity="0.6" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText"
                           Text="Quitar juego"
                           Margin="26,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButtonStyle}"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        ToolTip="Cerrar"
                        Click="CancelButton_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="26,4,26,20">
                <TextBlock x:Name="MessageText"
                           Style="{StaticResource DialogBodyStyle}"
                           FontSize="13.5"
                           LineHeight="21" />
                <TextBlock Text="Solo se quita de tu biblioteca de VICIOTEK. El juego instalado y sus archivos no se modifican."
                           Style="{StaticResource FieldHintStyle}"
                           Margin="0,14,0,0" />
            </StackPanel>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="26,0">
                    <Button x:Name="CancelButton"
                            Content="Cancelar"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="36"
                            Padding="18,0"
                            IsCancel="True"
                            IsDefault="True" />
                    <Button x:Name="ConfirmButton"
                            Content="Quitar"
                            Style="{StaticResource DangerButtonStyle}"
                            Margin="8,0,0,0"
                            Click="ConfirmButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</local:ViciotekDialogWindow>
